# Copy to .env. Read by docker compose (this directory) and by the backend
# when run from backend/ (copy it there too for local runs).

# Signs login tokens and, unless ORGRAPH_ENCRYPTION_KEY is set, encrypts stored
# connector credentials. Changing it later makes stored credentials unreadable.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ORGRAPH_SECRET_KEY=

# Optional dedicated Fernet key for connector credentials.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ORGRAPH_ENCRYPTION_KEY=

# --- local (non-Docker) runs ---------------------------------------------------
ORGRAPH_STORE_BACKEND=falkor
ORGRAPH_FALKORDB_HOST=localhost
ORGRAPH_FALKORDB_PORT=6379
ORGRAPH_REDIS_URL=redis://localhost:6379/1

# --- MCP server (Claude Code) --------------------------------------------------
ORGRAPH_API_URL=http://127.0.0.1:8000
# Create one in the UI: Settings -> API keys
ORGRAPH_API_KEY=

# --- placeholders for the future agent layer (unused today) --------------------
ORGRAPH_OPENROUTER_API_KEY=
ORGRAPH_JEV_API_KEY=
